<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CascDiagnostic</AssemblyName>
    <RootNamespace>CascDiagnostic</RootNamespace>
  </PropertyGroup>

  <!-- Bundle the native CascLib.dll from the main project's Tools folder -->
  <ItemGroup>
    <Content Include="..\D2RExtractor\Tools\CascLib.dll" Condition="Exists('..\D2RExtractor\Tools\CascLib.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>CascLib.dll</Link>
    </Content>
  </ItemGroup>

</Project>

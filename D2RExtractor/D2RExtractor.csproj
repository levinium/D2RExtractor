<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>D2RExtractor</AssemblyName>
    <RootNamespace>D2RExtractor</RootNamespace>
    <Version>1.1.7</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- Bundle the native CascLib.dll — Link flattens it to the output root next to the exe -->
  <ItemGroup>
    <Content Include="Tools\CascLib.dll" Condition="Exists('Tools\CascLib.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>CascLib.dll</Link>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <CascLibProjectPath>$(MSBuildProjectDirectory)\..\external\CascLib\CascLib_dll.vcxproj</CascLibProjectPath>
    <CascLibOutputPath>$(MSBuildProjectDirectory)\..\external\CascLib\bin\CascLib_dll\x64\$(Configuration)\CascLib.dll</CascLibOutputPath>
    <CascLibToolsPath>$(MSBuildProjectDirectory)\Tools\CascLib.dll</CascLibToolsPath>
    <CascLibBuildScript>$(MSBuildProjectDirectory)\..\scripts\Build-CascLib.ps1</CascLibBuildScript>
    <CascLib Condition="'$(CascLib)' == ''">false</CascLib>
  </PropertyGroup>

  <Target Name="BuildNativeCascLib" BeforeTargets="BeforeBuild" Condition="'$(CascLib)' == 'true' and '$(OS)' == 'Windows_NT' and Exists('$(CascLibBuildScript)')">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CascLibBuildScript)&quot; -RepoRoot &quot;$(MSBuildProjectDirectory)\..&quot; -Configuration &quot;$(Configuration)&quot; -CascLibProjectPath &quot;$(CascLibProjectPath)&quot; -CascLibOutputPath &quot;$(CascLibOutputPath)&quot; -CascLibToolsPath &quot;$(CascLibToolsPath)&quot;" />
  </Target>

</Project>

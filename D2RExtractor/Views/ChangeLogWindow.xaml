<Window x:Class="D2RExtractor.Views.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Log"
        Icon="/Resources/app.ico"
        Width="560" Height="440"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"  Color="#C8A951"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="#888888"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252525"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Change Log"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,12"/>

        <!-- Scrollable content -->
        <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel x:Name="EntriesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Close button -->
        <Button Grid.Row="2" Content="Close" Width="80" Padding="12,6"
                Margin="0,12,0,0" HorizontalAlignment="Right"
                Foreground="{StaticResource TextBrush}"
                Background="#2E2E2E" BorderBrush="#444" BorderThickness="1"
                Cursor="Hand" Click="CloseButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#383838"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>

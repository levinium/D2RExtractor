<Window x:Class="D2RExtractor.Views.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Log"
        Width="520" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"   Color="#C8A951"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MutedBrush"    Color="#888888"/>

        <Style TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"     Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Background="#252525" Padding="12">
            <StackPanel>
                <!-- v1.01 -->
                <TextBlock FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="v1.01  (2026-03-27)" Margin="0,0,0,4"/>
                <Separator Background="#444" Margin="0,0,0,8"/>

                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"
                           Text="• Added: International file extraction"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="16,0,0,12"
                           Text="Enable in Settings (gear icon, top-right) to also extract the locales folder, which includes international voice dubbing audio. Installations that were already extracted will automatically offer to extract the international files only, without re-extracting everything. Files not present in your installation are automatically skipped."/>

                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"
                           Text="• Added: Settings window"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="16,0,0,12"
                           Text="Accessible via the gear icon in the top-right corner of the app."/>

                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"
                           Text="• Added: Change Log window"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="16,0,0,24"
                           Text="Accessible via the gear icon → Change Log."/>

                <!-- v1.0 -->
                <TextBlock FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="v1.0  (initial release)" Margin="0,0,0,4"/>
                <Separator Background="#444" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="• Initial release."/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Width="80"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>

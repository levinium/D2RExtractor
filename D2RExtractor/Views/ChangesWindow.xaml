<Window x:Class="D2RExtractor.Views.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Last run"
        Icon="/Resources/app.ico"
        Width="820" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"   Color="#C8A951"/>
        <SolidColorBrush x:Key="AddedBrush"    Color="#27AE60"/>
        <SolidColorBrush x:Key="UpdatedBrush"  Color="#D4782A"/>
        <SolidColorBrush x:Key="RemovedBrush"  Color="#C0392B"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MutedBrush"    Color="#888888"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#252525"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E2E"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="12,5"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"  Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"  Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Heading -->
            <RowDefinition Height="Auto"/>   <!-- Summary -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="*"/>      <!-- List -->
            <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Grid.Row="0"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"/>

        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,6,0,10"
                   Foreground="{StaticResource TextBrush}" FontSize="12"
                   TextWrapping="Wrap"/>

        <StackPanel x:Name="FilterRow" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ShowAdded" IsChecked="True" Click="Filter_Changed"
                      Foreground="{StaticResource AddedBrush}" VerticalContentAlignment="Center"
                      Margin="0,0,14,0" Content="Added"/>
            <CheckBox x:Name="ShowUpdated" IsChecked="True" Click="Filter_Changed"
                      Foreground="{StaticResource UpdatedBrush}" VerticalContentAlignment="Center"
                      Margin="0,0,14,0" Content="Replaced"/>
            <CheckBox x:Name="ShowRemoved" IsChecked="True" Click="Filter_Changed"
                      Foreground="{StaticResource RemovedBrush}" VerticalContentAlignment="Center"
                      Margin="0,0,20,0" Content="Removed"/>

            <TextBox x:Name="FilterBox" Width="260"
                     Background="{StaticResource Surface2Brush}"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderBrush="#555" BorderThickness="1"
                     Padding="6,3" FontSize="12"
                     VerticalContentAlignment="Center"
                     TextChanged="Filter_Changed"
                     ToolTip="Show only paths containing this text"/>
            <TextBlock Text="filter by path" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#333" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <TextBlock x:Name="EmptyNotice"
                           Visibility="Collapsed"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="520"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>

                <ListView x:Name="ChangesList"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                   FontWeight="SemiBold" Padding="8,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KindLabel}" Value="Added">
                                                            <Setter Property="Foreground" Value="{StaticResource AddedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KindLabel}" Value="Replaced">
                                                            <Setter Property="Foreground" Value="{StaticResource UpdatedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KindLabel}" Value="Removed">
                                                            <Setter Property="Foreground" Value="{StaticResource RemovedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="File" Width="560">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelPath}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Consolas, Courier New" FontSize="11"
                                                   Padding="4,3"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Size" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeLabel}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Padding="4,3"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="ShownCount" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="ExportButton" Content="Save as text file…"
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="14,6" Margin="16,0,0,0" Click="Export_Click"/>
            <Button Content="Close" Style="{StaticResource BaseButtonStyle}"
                    Padding="18,6" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

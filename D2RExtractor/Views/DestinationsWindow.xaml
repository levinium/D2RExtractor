<Window x:Class="D2RExtractor.Views.DestinationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:D2RExtractor.Converters"
        Title="Destinations"
        Icon="/Resources/app.ico"
        Width="900" Height="560"
        MinWidth="880" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">

    <!-- MinWidth is set so the fixed columns (On 40 + Status 110 + Actions 320) and the buttons
         inside Actions always fit. The Destination column takes up the slack via
         RemainingWidthConverter, so widening the window widens the paths rather than leaving a
         gap, and narrowing it can never clip the buttons on the right. -->

    <Window.Resources>
        <!-- 40 (On) + 110 (Status) + 320 (Actions) + 24 border/scrollbar allowance -->
        <conv:RemainingWidthConverter x:Key="PathWidth" Reserved="494" Minimum="160"/>

        <SolidColorBrush x:Key="AccentBrush"   Color="#C8A951"/>  <!-- D2 gold -->
        <SolidColorBrush x:Key="DangerBrush"   Color="#C0392B"/>
        <SolidColorBrush x:Key="SuccessBrush"  Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush"  Color="#D4782A"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MutedBrush"    Color="#888888"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#252525"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E2E"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="12,5"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background"  Value="#4A3A10"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A4A18"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background"  Value="#3A1010"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A1818"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"  Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"  Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#333"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Heading -->
            <RowDefinition Height="Auto"/>   <!-- Blurb -->
            <RowDefinition Height="Auto"/>   <!-- Warning -->
            <RowDefinition Height="*"/>      <!-- List -->
            <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Grid.Row="0"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"/>

        <TextBlock Grid.Row="1" Margin="0,6,0,10"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   TextWrapping="Wrap"
                   Text="Extracted files are written to every enabled destination. The game folder is the only one D2R itself reads in -direct mode; extra destinations are for mods folders, manual patching, or keeping a separate copy. Each destination keeps its own records, so they can be extracted, updated and undone independently."/>

        <Border x:Name="GameFolderWarning" Grid.Row="2" Visibility="Collapsed"
                Background="#2A1E1E" BorderBrush="#5A3A3A" BorderThickness="1"
                CornerRadius="3" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap"
                       Text="No enabled destination is the game folder, so D2R will not load any faster and -direct -txt will find nothing. That is fine if you are extracting for a mods folder or for manual patching."/>
        </Border>

        <Border Grid.Row="3" BorderBrush="#333" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}">
            <ListView x:Name="TargetsList"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="On" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="Include this destination in Extract, Update and Undo"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Destination"
                                        Width="{Binding ActualWidth,
                                                RelativeSource={RelativeSource AncestorType=ListView},
                                                Converter={StaticResource PathWidth}}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FolderPath}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Status" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               VerticalAlignment="Center" Padding="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExtracted}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartiallyExtracted}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- The buttons size to their own text rather than to fixed widths. A fixed
                             width clips its label the moment the text is wider than the number
                             guessed for it, which is what Windows' "make text bigger" setting and a
                             longer word both do. MinWidth keeps the row tidy when the text is
                             short. -->
                        <GridViewColumn Header="Actions" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,4" VerticalAlignment="Center">
                                        <Button Content="Extract" MinWidth="66" Margin="0,0,5,0"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTip="Extract or update this destination on its own"
                                                Tag="{Binding}" Click="ExtractOne_Click"/>
                                        <Button Content="Changes" MinWidth="70" Margin="0,0,5,0"
                                                Style="{StaticResource BaseButtonStyle}"
                                                ToolTip="What the last run added, replaced and removed here"
                                                Tag="{Binding}" Click="Changes_Click"/>
                                        <Button Content="Undo" MinWidth="56" Margin="0,0,5,0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="{Binding HasManifest}"
                                                ToolTip="Remove the files extracted to this destination"
                                                Tag="{Binding}" Click="UndoOne_Click"/>
                                        <Button Content="Remove" MinWidth="66"
                                                Style="{StaticResource BaseButtonStyle}"
                                                ToolTip="Stop managing this destination (does not delete files)"
                                                Tag="{Binding}" Click="RemoveTarget_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="+ Add destination" Style="{StaticResource BaseButtonStyle}"
                    Padding="14,6" Margin="0,0,8,0" Click="AddTarget_Click"/>
            <Button Content="Rename" Style="{StaticResource BaseButtonStyle}"
                    Padding="14,6" Margin="0,0,8,0" Click="Rename_Click"
                    ToolTip="Give the selected destination a friendly name"/>
            <TextBlock Text="Files are never deleted by removing a destination — use Undo for that."
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="Close" Style="{StaticResource BaseButtonStyle}"
                    Padding="18,6" HorizontalAlignment="Right"
                    Click="Close_Click" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

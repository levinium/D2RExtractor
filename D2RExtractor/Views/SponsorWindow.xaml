<Window x:Class="D2RExtractor.Views.SponsorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support D2R File Extractor"
        Icon="/Resources/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        ResizeMode="NoResize">

    <!-- The only place this app asks for anything, and it is behind a heart
         nobody has to press. So it is written to be easy to say no to: no
         countdown, nothing pre-ticked beyond the amount itself, and a door that
         is obviously open. An ask that has to trick someone is not worth the
         money.

         SizeToContent, because the picker is there only where the destination
         accepts an amount and a fixed height would leave a hole otherwise. -->

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"   Color="#C8A951"/>  <!-- D2 gold -->
        <SolidColorBrush x:Key="TextBrush"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="MutedBrush"    Color="#888888"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#252525"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#2E2E2E"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background"  Value="#4A3A10"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A4A18"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An amount chip. "chosen" is carried by Tag rather than a toggle,
             because only one is ever chosen and the code-behind already owns
             which one that is. -->
        <Style x:Key="AmountChipStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Padding"  Value="10,5"/>
            <Setter Property="Margin"   Value="0,0,8,0"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="chosen">
                    <Setter Property="Background"  Value="#4A3A10"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Support D2R File Extractor"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- What it is and what it is not. The second sentence is the one that
             matters: someone deciding whether to give should know they are not
             buying anything, and that nothing is being withheld. -->
        <TextBlock Text="D2R File Extractor is free and open source. There is no paid version, nothing is held back, and this is the only place it asks."
                   Foreground="{StaticResource TextBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="If it has saved you some loading screens, you can put something toward keeping it working after the next patch."
                   Foreground="{StaticResource TextBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <StackPanel x:Name="AmountPanel" Margin="0,0,0,16">
            <StackPanel x:Name="ChipRow" Orientation="Horizontal" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="OtherChip" Content="Other"
                        Style="{StaticResource AmountChipStyle}"
                        Click="OtherChip_Click"/>
                <TextBox x:Name="OtherAmountBox"
                         Width="110" Visibility="Collapsed"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource Surface2Brush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="#555" BorderThickness="1"
                         CaretBrush="{StaticResource TextBrush}"
                         Padding="6,4" FontSize="12"
                         TextChanged="OtherAmountBox_TextChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="SponsorButton"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="150" Padding="14,7"
                    Margin="0,0,8,0"
                    Click="SponsorButton_Click"/>
            <Button Content="Not now"
                    Style="{StaticResource BaseButtonStyle}"
                    MinWidth="80" Padding="14,7"
                    Click="DismissButton_Click"/>
        </StackPanel>

        <TextBlock Text="Opens your browser. D2R File Extractor never sees your payment details."
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Window>

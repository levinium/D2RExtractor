# Build output
[Bb]in/
[Oo]bj/

# Scratch csproj the WPF targets write beside the real one during a build
*_wpftmp.csproj

# Visual Studio / Rider / VS Code workspace state
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Publish artifacts
publish/
dist/
*.zip

# Logs and crash dumps
*.log
*.dmp

# NuGet
*.nupkg
packages/

# The native CascLib.dll is intentionally tracked (see D2RExtractor/Tools/) —
# the build copies it next to the executable and it is required to build.
!D2RExtractor/Tools/CascLib.dll
